{
"compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "types": ["node"],

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "allowJs": true,
    "checkJs": false,

    "sourceMap": true
},
"include": [
    "index.ts",
    "functions/**/*",
    "commands/**/*",
    "sessionsCommands/**/*",
    "types/**/*"
],
"exclude": ["node_modules", "dist", "sessions"]
}